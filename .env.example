# Deployment secrets and model selection only.
#
# Copy this to `.env`, add only the credentials you use, and select the models
# for this deployment. Edit `config/runtime.yaml` for every non-secret runtime
# setting: paths, scanner cadence, budgets, timeouts, logging, MCP and the
# generated document's name. That tracked file is the canonical configuration.
#
# Any setting may still be supplied through the real process environment for a
# deployment-specific override. Keep connection strings there too; do not put
# production database credentials in the tracked runtime file.

# ── credentials ───────────────────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional shared credentials for a protected API or HTTP MCP server.
API_TOKEN=
MCP_TOKEN=

# Optional deployment-only connection override. The tracked development
# default is in config/runtime.yaml; Docker Compose supplies its own value.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# ── where your pile folders live ──────────────────────────────────────────
# The folder Docker watches. Every subfolder of it is one pile: its files are
# read, cross-checked, reviewed in the dashboard, and final-document.docx is
# written back into that same subfolder. Default: ./watched inside this repo.
# Use an absolute path to watch a folder anywhere else (no ~, Docker does not
# expand it), e.g. WATCH_DIR=/Users/you/Documents/contracts
WATCH_DIR=./watched

# ── provider and models ───────────────────────────────────────────────────
# Gemini, anthropic, or openai. Blank LLM model names use the provider defaults
# listed in config/runtime.yaml.
LLM_PROVIDER=gemini
LLM_MODEL_EXTRACT=
LLM_MODEL_JUDGE=

# OpenAI embeddings are required even when the LLM provider is Gemini or
# Anthropic. These three local-model identifiers are overrideable per deploy.
EMBEDDING_MODEL=text-embedding-3-small
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
GLINER_MODEL=knowledgator/gliner-pii-base-v1.0
